{
  "name": "agemocratie",
  "main": "worker.py",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "python_workers",
    "python_workers_314"
  ],
  "secrets": {
    "required": ["APP_SECRET_KEY", "AG_CODE_KEY", "LEGACY_AG_CODE_KEY"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agemocratie-db",
      "database_id": "b94f9fcb-2366-4779-a1a0-dacb8d06591c"
    }
  ],
  "assets": {
    "directory": "./public"
  },
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true }
  }
}
