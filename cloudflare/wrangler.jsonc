{
  "name": "agemocratie",
  "main": "worker.py",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "python_workers",
    "python_workers_314"
  ],
  "secrets": {
    "required": [
      "APP_SECRET_KEY",
      "AG_CODE_KEY",
      "AG_MAIL_URL",
      "AG_MAIL_SECRET"
    ]
  },
  "vars": {"AG_MAIL_PROVIDER": "gmail"},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agemocratie-db",
      "database_id": "b94f9fcb-2366-4779-a1a0-dacb8d06591c"
    }
  ],
  "assets": {
    "directory": "./public"
  },
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": {
      "invocation_logs": false
    }
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
